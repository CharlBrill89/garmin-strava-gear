# Copy to .env — .env is gitignored and must never be committed.
# strava_auth.py writes these for you; you don't need to fill them in by hand.

# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Written by strava_auth.py after the OAuth exchange
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=
STRAVA_EXPIRES_AT=

# Optional: Garmin credentials, so any session can log in without a prompt.
# Only read when the cached tokens are missing or expired. Plaintext — readable
# by anything running as you. Leave both unset to be prompted interactively.
# GARMIN_EMAIL=
# GARMIN_PASSWORD=

# Optional: where the Garmin session tokens are cached.
# Defaults to ~/.garminconnect. These tokens are what later runs actually use;
# the password above is only needed to mint them.
# GARMINTOKENS=~/.garminconnect
